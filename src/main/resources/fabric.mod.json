{
  "schemaVersion": 1,
  "id": "sky_birds",
  "version": "${version}",
  "name": "Sky Birds",
  "description": "Ambient birds in the sky. Flocks, V-formations, circling hawks and starling murmurations that react to weather, time of day and explosions.",
  "authors": ["Vhinky"],
  "contact": {
    "sources": "https://github.com/Vhinky/sky-birds-fabric"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/sky_birds/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.vhinky.skybirds.SkyBirds"],
    "client": ["com.vhinky.skybirds.SkyBirdsClient"]
  },
  "mixins": [
    {
      "config": "sky_birds.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21 <=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}